# =====================================================================
# ER:ON — .gitignore
#
# 최우선 원칙: MIMIC-IV 원천 데이터와 환자 데이터는 어떤 경로로도
# 저장소에 들어가지 않는다. (PhysioNet Credentialed Health Data License)
#
# 데이터 확장자는 "경로 무관 전면 차단"이 기본이다.
# 정말 커밋해야 하는 파일이 생기면 `git add -f` 로 의도를 명시할 것.
# =====================================================================


# ---------------------------------------------------------------------
# 1. 비밀정보 / 자격증명
# ---------------------------------------------------------------------
.env
.env.*

# 키 이름만 담긴 템플릿이므로 추적 대상
# (gitignore 는 줄 끝 주석을 지원하지 않는다. 주석은 반드시 별도 줄에 쓸 것)
!.env.example

# Cloudflare / wrangler 로컬 시크릿
.dev.vars
secrets/
*.pem
*.key
*.p12
*.pfx
service-account*.json
credentials*.json


# ---------------------------------------------------------------------
# 2. MIMIC-IV 원천 데이터 (디렉터리 통째로)
# ---------------------------------------------------------------------
MIMIC-IV-ED/
MIMIC-IV-HOSP/
MIMIC-IV-ICU/
MIMIC-IV-*/
mimic-iv*/
mimic/
physionet*/

data/
datasets/
dataset/

# 내보낸 데이터. MIMIC 파생물이므로 확장자와 무관하게 디렉터리째 제외한다.
# (*.csv 로만 걸어두면 json/xlsx 등으로 뽑았을 때 새어 나간다)
exports/


# ---------------------------------------------------------------------
# 3. 데이터 파일 확장자 — 경로 무관 전면 차단
#
#    · 코호트 정의는 파일이 아니라 DB(app.cohort)에 있다. 여기서 막을 대상이 없다.
#    · *.sql 은 제외하지 않는다 — database/init/*.sql 스키마 파일이 필요하다.
# ---------------------------------------------------------------------
*.csv
*.tsv
*.psv
*.parquet
*.feather
*.arrow
*.orc
*.avro
*.jsonl
*.ndjson
*.xls
*.xlsx

*.gz
*.bz2
*.xz
*.zst
*.7z
*.tar
*.zip

*.h5
*.hdf5
*.npy
*.npz


# ---------------------------------------------------------------------
# 4. DB 덤프 / 로컬 DB / 컨테이너 볼륨
# ---------------------------------------------------------------------
*.dump
*.bak
*.sqlite
*.sqlite3
*.db

pgdata/
postgres_data/
postgres-data/


# ---------------------------------------------------------------------
# 5. 환자 유래 미디어 (STT 음성, 의료영상 등)
# ---------------------------------------------------------------------
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.dcm
*.nii
*.nii.gz


# ---------------------------------------------------------------------
# 6. ML 아티팩트
# ---------------------------------------------------------------------
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.onnx
*.ckpt
*.safetensors


# ---------------------------------------------------------------------
# 7. Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/


# ---------------------------------------------------------------------
# 8. Node / Frontend 빌드 산출물
#    (.output 등에는 빌드 시점 주입 환경변수가 포함될 수 있다)
# ---------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.output/
.nitro/
.vinxi/
.tanstack/
.wrangler/
*.local


# ---------------------------------------------------------------------
# 9. 로그 / OS / 에디터
# ---------------------------------------------------------------------
*.log
logs/
.DS_Store
Thumbs.db
.idea/
