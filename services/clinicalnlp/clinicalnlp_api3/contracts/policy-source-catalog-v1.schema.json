{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eron:policy-source-catalog-v1",
  "title": "ER:ON Policy Source Catalog v1",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_version",
    "snapshot_at",
    "active_source_versions",
    "rule_source_map",
    "documents"
  ],
  "properties": {
    "schema_version": {"const": "eron-policy-source-catalog-v1"},
    "catalog_version": {"type": "string", "minLength": 1},
    "snapshot_at": {"type": "string", "format": "date"},
    "active_source_versions": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "rule_source_map": {
      "type": "object",
      "minProperties": 20,
      "maxProperties": 20,
      "patternProperties": {
        "^G(?:0[1-9]|1[0-9]|20)$": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/document"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "document": {
      "type": "object",
      "required": [
        "source_id",
        "source_family_id",
        "title",
        "document_type",
        "usage_scope",
        "jurisdiction",
        "published_at",
        "snapshot_at",
        "source_path",
        "source_url",
        "document_hash",
        "basis_type",
        "rule_ids",
        "supersedes_source_id"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_family_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "document_type": {
          "enum": [
            "OFFICIAL_LAW",
            "OFFICIAL_GUIDELINE",
            "INTERNATIONAL_GUIDELINE",
            "DATA_SPECIFICATION",
            "TECHNICAL_REFERENCE",
            "EVALUATION_REFERENCE",
            "PROJECT_RULESET",
            "PROJECT_THRESHOLDS"
          ]
        },
        "usage_scope": {
          "enum": [
            "RUNTIME_VALIDATION",
            "MEDICAL_DEVICE_ONLY",
            "OFFLINE_EVALUATION"
          ]
        },
        "jurisdiction": {"type": "string", "minLength": 1},
        "published_at": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 4}]
        },
        "snapshot_at": {"type": "string", "format": "date"},
        "source_path": {"type": "string", "minLength": 1},
        "archive_member": {"type": "string", "minLength": 1},
        "source_url": {
          "oneOf": [{"type": "null"}, {"type": "string", "format": "uri"}]
        },
        "document_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "basis_type": {
          "enum": [
            "OFFICIAL_LAW",
            "OFFICIAL_PRINCIPLE",
            "DATA_SPECIFICATION",
            "TECHNICAL_REFERENCE",
            "PROJECT_POLICY",
            "PROJECT_THRESHOLD"
          ]
        },
        "rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^G(?:0[1-9]|1[0-9]|20)$"
          }
        },
        "supersedes_source_id": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
        }
      },
      "additionalProperties": false
    }
  }
}

