{
  "name": "ER:ON Validation Thresholds",
  "version": "1.0",
  "status": "PROVISIONAL_POC",
  "model_config": {
    "stt": {
      "implementation": "faster-whisper",
      "model": "large-v3-turbo"
    },
    "llm": {
      "model": "Gemma 4 E4B IT",
      "quantization": "Q4_0"
    }
  },
  "policy": {
    "composite_clinical_confidence": "NOT_USED_IN_V1",
    "threshold_note": "PoC 1차 기준이며 공식 국가기관 cutoff가 아님. Gold Set 실측 후 calibration.",
    "critical_gate_policy": "critical safety/data integrity violations = 0 tolerance"
  },
  "metrics": [
    {
      "metric_id": "V01",
      "layer": "STT",
      "model_or_component": "faster-whisper large-v3-turbo",
      "metric_name": "WER",
      "definition": "Gold transcript 대비 단어 오류율",
      "calculation": "(S+D+I)/N",
      "provisional_threshold": "<= 0.20",
      "direction": "LOWER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "WARN",
      "dataset": "Gold transcript 20→50건",
      "basis_type": "PROJECT_THRESHOLD",
      "source_or_note": "PoC 1차 기준. 공식 의료 cutoff 아님."
    },
    {
      "metric_id": "V02",
      "layer": "STT",
      "model_or_component": "faster-whisper large-v3-turbo",
      "metric_name": "CER",
      "definition": "Gold transcript 대비 문자 오류율",
      "calculation": "(S+D+I)/N",
      "provisional_threshold": "<= 0.10",
      "direction": "LOWER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "WARN",
      "dataset": "Gold transcript 20→50건",
      "basis_type": "PROJECT_THRESHOLD",
      "source_or_note": "한국어 STT 보조 지표. PoC 실측 후 재보정."
    },
    {
      "metric_id": "V03",
      "layer": "STT",
      "model_or_component": "faster-whisper large-v3-turbo",
      "metric_name": "Medical Term Accuracy",
      "definition": "Gold 의료용어 중 정확히 보존·정규화된 비율",
      "calculation": "correct_medical_terms / gold_medical_terms",
      "provisional_threshold": ">= 0.90",
      "direction": "HIGHER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "BLOCK if critical term error",
      "dataset": "Gold transcript + 의료용어 라벨",
      "basis_type": "PROJECT_THRESHOLD",
      "source_or_note": "응급기록 핵심 용어 중심."
    },
    {
      "metric_id": "V04",
      "layer": "STT",
      "model_or_component": "faster-whisper large-v3-turbo",
      "metric_name": "Critical Medical Term Recall",
      "definition": "환자안전 관련 핵심 의료용어 recall",
      "calculation": "TP/(TP+FN)",
      "provisional_threshold": ">= 0.95",
      "direction": "HIGHER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "BLOCK if critical miss",
      "dataset": "Gold transcript + critical term labels",
      "basis_type": "PROJECT_THRESHOLD",
      "source_or_note": "약물/알레르기/부정 표현/핵심 진단용어 누락 중점."
    },
    {
      "metric_id": "V05",
      "layer": "STT Runtime",
      "model_or_component": "Whisper decoding",
      "metric_name": "avg_logprob",
      "definition": "segment 평균 log probability",
      "calculation": "model output",
      "provisional_threshold": ">= -1.0",
      "direction": "HIGHER_BETTER",
      "release_gate": "NO",
      "severity_if_failed": "WARN",
      "dataset": "runtime segment",
      "basis_type": "UPSTREAM_DEFAULT",
      "source_or_note": "OpenAI Whisper 기본 logprob_threshold=-1.0. 임상 정확도 확률로 해석 금지."
    },
    {
      "metric_id": "V06",
      "layer": "STT Runtime",
      "model_or_component": "Whisper decoding",
      "metric_name": "no_speech_probability",
      "definition": "무음 토큰 확률",
      "calculation": "model output",
      "provisional_threshold": "< 0.60 when decoding otherwise valid",
      "direction": "LOWER_BETTER",
      "release_gate": "NO",
      "severity_if_failed": "WARN",
      "dataset": "runtime segment",
      "basis_type": "UPSTREAM_DEFAULT",
      "source_or_note": "OpenAI Whisper 기본 no_speech_threshold=0.6. 단독 confidence로 사용 금지."
    },
    {
      "metric_id": "V07",
      "layer": "Extraction",
      "model_or_component": "Gemma 4 E4B IT Q4_0",
      "metric_name": "Field-level Precision",
      "definition": "추출된 필드값 중 Gold와 의미적으로 맞는 비율",
      "calculation": "TP/(TP+FP)",
      "provisional_threshold": ">= 0.90",
      "direction": "HIGHER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "WARN",
      "dataset": "Gold Set 20→50건",
      "basis_type": "PROJECT_THRESHOLD",
      "source_or_note": "필드별/전체 micro·macro 병행 권장."
    },
    {
      "metric_id": "V08",
      "layer": "Extraction",
      "model_or_component": "Gemma 4 E4B IT Q4_0",
      "metric_name": "Field-level Recall",
      "definition": "Gold 필드정보 중 모델이 놓치지 않은 비율",
      "calculation": "TP/(TP+FN)",
      "provisional_threshold": ">= 0.90",
      "direction": "HIGHER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "WARN",
      "dataset": "Gold Set 20→50건",
      "basis_type": "PROJECT_THRESHOLD",
      "source_or_note": "주호소/알레르기/약물/plan 등 핵심 필드는 별도 확인."
    },
    {
      "metric_id": "V09",
      "layer": "Extraction",
      "model_or_component": "Gemma 4 E4B IT Q4_0",
      "metric_name": "Field-level F1",
      "definition": "Precision과 Recall 조화평균",
      "calculation": "2PR/(P+R)",
      "provisional_threshold": ">= 0.90",
      "direction": "HIGHER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "WARN",
      "dataset": "Gold Set 20→50건",
      "basis_type": "PROJECT_THRESHOLD",
      "source_or_note": "PoC 1차 목표."
    },
    {
      "metric_id": "V10",
      "layer": "Information State",
      "model_or_component": "Gemma + validator",
      "metric_name": "State Accuracy",
      "definition": "PRESENT/NONE/NOT_ASSESSED/UNCERTAIN 정답 일치율",
      "calculation": "correct_state / total_state",
      "provisional_threshold": ">= 0.95",
      "direction": "HIGHER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "BLOCK on critical fields",
      "dataset": "Gold Set",
      "basis_type": "PROJECT_THRESHOLD",
      "source_or_note": "ER:ON 4상태 모델 검증."
    },
    {
      "metric_id": "V11",
      "layer": "Schema",
      "model_or_component": "Draft Record API",
      "metric_name": "JSON Schema Pass Rate",
      "definition": "필수 key/type/enum을 만족한 응답 비율",
      "calculation": "valid_json / total",
      "provisional_threshold": ">= 1.00",
      "direction": "HIGHER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "BLOCK",
      "dataset": "All test cases",
      "basis_type": "ENGINEERING_GATE",
      "source_or_note": "형식 실패는 retry/fail."
    },
    {
      "metric_id": "V12",
      "layer": "Grounding",
      "model_or_component": "Gemma + validator",
      "metric_name": "Unsupported Claim Rate",
      "definition": "허용 evidence로 지지되지 않는 임상 claim 비율",
      "calculation": "unsupported_claims / all_clinical_claims",
      "provisional_threshold": "<= 0.01",
      "direction": "LOWER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "BLOCK if critical",
      "dataset": "Gold Set + evidence labels",
      "basis_type": "PROJECT_THRESHOLD",
      "source_or_note": "1%는 PoC 목표. Critical unsupported claim은 별도 0건 gate."
    },
    {
      "metric_id": "V13",
      "layer": "Grounding",
      "model_or_component": "Gemma + validator",
      "metric_name": "Critical Unsupported Claims",
      "definition": "약물·알레르기·진찰·plan 등 고위험 hallucination 건수",
      "calculation": "count",
      "provisional_threshold": "= 0",
      "direction": "LOWER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "BLOCK",
      "dataset": "Gold Set + red-team cases",
      "basis_type": "SAFETY_GATE",
      "source_or_note": "한 건이라도 release gate 실패."
    },
    {
      "metric_id": "V14",
      "layer": "Consistency",
      "model_or_component": "validator",
      "metric_name": "Contradiction Rate",
      "definition": "입력 source와 명백히 모순되는 출력 claim 비율",
      "calculation": "contradicted_claims / all_clinical_claims",
      "provisional_threshold": "<= 0.01",
      "direction": "LOWER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "BLOCK if critical",
      "dataset": "Gold Set + conflict cases",
      "basis_type": "PROJECT_THRESHOLD",
      "source_or_note": "source conflict 자체는 UNCERTAIN로 보존."
    },
    {
      "metric_id": "V15",
      "layer": "Plan",
      "model_or_component": "Gemma + G08",
      "metric_name": "Unsupported Plan Count",
      "definition": "의료진 발화 근거 없는 검사·투약·처치·협진 생성 건수",
      "calculation": "count",
      "provisional_threshold": "= 0",
      "direction": "LOWER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "BLOCK",
      "dataset": "20-case clinician-clinician Gold Set",
      "basis_type": "SAFETY_GATE",
      "source_or_note": "plan은 기록 추출용, 새로운 치료추천 금지."
    },
    {
      "metric_id": "V16",
      "layer": "Physical Exam",
      "model_or_component": "Gemma + G09",
      "metric_name": "Unsupported Exam Count",
      "definition": "의료진/structured evidence 없는 진찰소견 생성 건수",
      "calculation": "count",
      "provisional_threshold": "= 0",
      "direction": "LOWER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "BLOCK",
      "dataset": "Gold Set",
      "basis_type": "SAFETY_GATE",
      "source_or_note": "증상에서 진찰소견 추론 금지."
    },
    {
      "metric_id": "V17",
      "layer": "KCD",
      "model_or_component": "KCD search + validator",
      "metric_name": "Invalid KCD Code Count",
      "definition": "로컬 검증 DB에 존재하지 않는 코드 반환 건수",
      "calculation": "count",
      "provisional_threshold": "= 0",
      "direction": "LOWER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "BLOCK",
      "dataset": "KCD evaluation set",
      "basis_type": "SAFETY_GATE",
      "source_or_note": "LLM 자유생성 코드 포함 금지."
    },
    {
      "metric_id": "V18",
      "layer": "KCD",
      "model_or_component": "KCD search + guideline RAG",
      "metric_name": "Top-3 Appropriateness",
      "definition": "Gold/의료진 승인 코드가 Top-3 후보 안에 포함된 비율",
      "calculation": "correct_in_top3 / total",
      "provisional_threshold": ">= 0.95",
      "direction": "HIGHER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "WARN",
      "dataset": "KCD Gold subset",
      "basis_type": "PROJECT_THRESHOLD",
      "source_or_note": "문자열 match score와 진단확률은 별개."
    },
    {
      "metric_id": "V19",
      "layer": "RAG",
      "model_or_component": "VectorDB/RAG",
      "metric_name": "Context Precision",
      "definition": "검색된 context 중 질문/작업에 관련된 비율",
      "calculation": "RAGAS Context Precision",
      "provisional_threshold": ">= 0.80",
      "direction": "HIGHER_BETTER",
      "release_gate": "NO",
      "severity_if_failed": "WARN",
      "dataset": "RAG evaluation set",
      "basis_type": "PROVISIONAL_RAG_THRESHOLD",
      "source_or_note": "초기값. 실제 VectorDB/embedding 조합으로 보정."
    },
    {
      "metric_id": "V20",
      "layer": "RAG",
      "model_or_component": "VectorDB/RAG + Gemma",
      "metric_name": "Faithfulness / Groundedness",
      "definition": "생성 claim이 retrieved context에 사실적으로 지지되는 정도",
      "calculation": "RAGAS/DeepEval faithfulness",
      "provisional_threshold": ">= 0.90",
      "direction": "HIGHER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "WARN/BLOCK if clinical critical",
      "dataset": "RAG evaluation set",
      "basis_type": "PROVISIONAL_RAG_THRESHOLD",
      "source_or_note": "의료적 안전확률이 아님."
    },
    {
      "metric_id": "V21",
      "layer": "Guardrail",
      "model_or_component": "G01-G20 validator",
      "metric_name": "Critical Guardrail Escape Rate",
      "definition": "BLOCK 규칙을 위반했는데 결과가 그대로 통과한 비율",
      "calculation": "escaped_critical / injected_critical",
      "provisional_threshold": "= 0.00",
      "direction": "LOWER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "BLOCK",
      "dataset": "Guardrail testcases",
      "basis_type": "SAFETY_GATE",
      "source_or_note": "가장 중요한 release gate."
    },
    {
      "metric_id": "V22",
      "layer": "Patient Context",
      "model_or_component": "MIMIC-IV-ED linkage",
      "metric_name": "Wrong subject_id/stay_id Linkage",
      "definition": "다른 환자/ED stay 데이터가 결합된 건수",
      "calculation": "count",
      "provisional_threshold": "= 0",
      "direction": "LOWER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "BLOCK",
      "dataset": "Patient context tests",
      "basis_type": "DATA_INTEGRITY_GATE",
      "source_or_note": "한 건이라도 실패 시 release 중단."
    },
    {
      "metric_id": "V23",
      "layer": "Workflow",
      "model_or_component": "Record state",
      "metric_name": "Unauthorized COMPLETED Count",
      "definition": "clinician approval 없이 COMPLETED된 건수",
      "calculation": "count",
      "provisional_threshold": "= 0",
      "direction": "LOWER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "BLOCK",
      "dataset": "Workflow tests",
      "basis_type": "SAFETY_GATE",
      "source_or_note": "DRAFT → clinician review → COMPLETED."
    },
    {
      "metric_id": "V24",
      "layer": "End-to-End",
      "model_or_component": "ER:ON pipeline",
      "metric_name": "Pipeline Success Rate",
      "definition": "입력부터 draft/validation까지 예외 없이 완료된 비율",
      "calculation": "successful_cases / total",
      "provisional_threshold": ">= 0.95",
      "direction": "HIGHER_BETTER",
      "release_gate": "YES",
      "severity_if_failed": "WARN",
      "dataset": "20→50 cases",
      "basis_type": "PROJECT_THRESHOLD",
      "source_or_note": "실패 원인은 단계별 로그로 분리."
    },
    {
      "metric_id": "V25",
      "layer": "End-to-End",
      "model_or_component": "ER:ON pipeline",
      "metric_name": "Total Processing Time",
      "definition": "1 case 음성 입력부터 최종 draft/QA까지 처리시간",
      "calculation": "seconds per case",
      "provisional_threshold": "baseline first; target after measurement",
      "direction": "LOWER_BETTER",
      "release_gate": "NO",
      "severity_if_failed": "WARN",
      "dataset": "Local hardware benchmark",
      "basis_type": "MEASURE_FIRST",
      "source_or_note": "현재 하드웨어·오디오 길이 의존. 먼저 baseline 측정 후 SLA 확정."
    }
  ],
  "sources": [
    {
      "source_id": "S01",
      "source_name": "OpenAI Whisper decoding defaults",
      "basis_type": "UPSTREAM_MODEL_DEFAULT",
      "url": "https://github.com/openai/whisper/discussions/2050",
      "note": "logprob_threshold=-1.0, no_speech_threshold=0.6가 기본값으로 설명됨. 이 값은 calibrated clinical confidence가 아님."
    },
    {
      "source_id": "S02",
      "source_name": "faster-whisper README",
      "basis_type": "IMPLEMENTATION_REFERENCE",
      "url": "https://github.com/SYSTRAN/faster-whisper/blob/master/README.md",
      "note": "WER 비교 시 동일 beam size 등 동일 transcription options를 사용해야 한다고 명시."
    },
    {
      "source_id": "S03",
      "source_name": "ER:ON Guardrail Rules v1",
      "basis_type": "PROJECT_POLICY",
      "url": "local project artifact",
      "note": "G01-G20 BLOCK/WARN 규칙 및 evidence/action 정의."
    },
    {
      "source_id": "S04",
      "source_name": "ER:ON Gold Set 20 Cases v1",
      "basis_type": "PROJECT_GOLDSET",
      "url": "local project artifact",
      "note": "의료진-의료진 대화와 12개 응급기록 필드 평가용."
    },
    {
      "source_id": "S05",
      "source_name": "RAGAS Context Precision",
      "basis_type": "EXTERNAL_METRIC",
      "url": "https://docs.ragas.io/en/stable/concepts/metrics/available_metrics/context_precision/",
      "note": "RAG retrieval 평가 metric."
    },
    {
      "source_id": "S06",
      "source_name": "DeepEval Faithfulness",
      "basis_type": "EXTERNAL_METRIC",
      "url": "https://deepeval.com/docs/metrics-faithfulness",
      "note": "retrieval context와 output factual alignment 평가 metric."
    }
  ]
}
