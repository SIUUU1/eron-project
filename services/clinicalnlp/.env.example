# Copy this file to services/clinicalnlp/.env for local use.
# Never commit the resulting .env file.
CLINICAL_LLM_PROVIDER=ollama_cloud
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b
OLLAMA_TIMEOUT=170

CLINICALNLP_HTTP_HOST=0.0.0.0
CLINICALNLP_HTTP_PORT=8765
CLINICALNLP_HTTP_TIMEOUT=180
CLINICALNLP_API3_CONTEXT=8192
CLINICALNLP_GEMMA_MAX_TOKENS=3072
CLINICALNLP_QUERY_EXPANSION_MAX_TOKENS=1536
CLINICALNLP_QUERY_EXPANSION_PASSES=1
CLINICALNLP_TRANSLATION_BATCH_SIZE=3

# Read-only OCI Block Volume mounts.
CLINICALNLP_API3_DB_ROOT=/runtime/medical-dictionaries
# postgres: active PG release (default); shadow: return SQLite and compare PG;
# sqlite: emergency rollback while the source assets remain mounted.
CLINICALNLP_TERMINOLOGY_BACKEND=postgres
# postgres: active PG vector releases (default); shadow: SQLite response + PG compare;
# sqlite: emergency rollback while api3_vectors.sqlite remains mounted.
CLINICALNLP_MEDICAL_VECTOR_BACKEND=postgres
# Required for postgres/shadow. Compose injects the root DATABASE_URL.
# Set this directly only when running the service outside Compose.
CLINICALNLP_DATABASE_URL=
CLINICALNLP_API3_VECTOR_INDEX=/runtime/vectors/api3_vectors.sqlite
CLINICALNLP_POLICY_INDEX=/runtime/policy/policy_vectors.sqlite

# Writable, separately backed-up approval state.
CLINICALNLP_ALIAS_DB=/runtime/state/alias_feedback.sqlite

# Optional heavy scispaCy/UMLS runtime. Missing assets degrade to n-gram fallback.
CLINICALNLP_UMLS_ENABLED=true
CLINICALNLP_UMLS_TIMEOUT=90
CLINICALNLP_UMLS_PYTHON=/runtime/scispacy/.venv/bin/python
CLINICALNLP_UMLS_WORKER=/app/scripts/medical_span_worker.py
CLINICALNLP_UMLS_CACHE_ROOT=/runtime/scispacy/cache
