# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# 컨테이너 네트워크 기준. 예: postgresql+psycopg://user:pw@postgres:5432/eron
DATABASE_URL=

# ---------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------
# nginx 뒤에서는 프론트와 API 가 동일 오리진이라 CORS 가 필요 없다.
# 컨테이너 밖에서 vite dev 를 띄울 때만 채운다. 콤마 구분. 예: http://localhost:5173
CORS_ORIGINS=

# 컨테이너 시계. 데모 시간축과 now() 비교가 어긋나지 않게 맞춘다.
TZ=Asia/Seoul

# ---------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------
# 비워두면 상대 경로(/api/...)로 호출한다 — nginx 구성에서는 이게 기본이다.
# VITE_* 는 빌드 시점에 번들에 고정되므로 절대 URL 을 넣으면 재빌드 없이는 못 바꾼다.
VITE_API_BASE_URL=

# ---------------------------------------------------------------------
# nginx / TLS (OCI 배포 전용)
# ---------------------------------------------------------------------
# 셋 다 비워두면 로컬 기본값이 쓰이고 nginx 는 :80 만 띄운다(HTTPS 꺼짐).
# OCI 에서만 아래 세 줄을 채워 HTTPS 를 켠다.
#
#   NGINX_TLS_DIR=./nginx/tls-available
#   LETSENCRYPT_DIR=/etc/letsencrypt
#   CERTBOT_WEBROOT=/var/www/certbot
#
# ---------------------------------------------------------------------
# 런타임 자산 경로 (Docker Compose bind mount)
# ---------------------------------------------------------------------
# clinicalnlp 의 scispaCy 모델과 의료사전이 놓인 디렉터리의 부모.
# compose 는 아래 두 경로를 읽기 전용으로 마운트하며 create_host_path=false 라
# 디렉터리가 없으면 backend/clinicalnlp 가 기동하지 않는다(무음 실패가 아니다).
#
#   ${CLINICALNLP_RUNTIME_ROOT}/scispacy
#   ${CLINICALNLP_RUNTIME_ROOT}/medical-dictionaries
#
# /runtime/ 은 .gitignore 로 제외되므로 clone 직후에는 존재하지 않는다.
# 새 서버에서는 배포 전에 반드시 만들어야 한다 — docs/oci-deployment.md 참조.
#
#   mkdir -p runtime/clinicalnlp/{scispacy,medical-dictionaries}
#
# 비워두면 ./runtime/clinicalnlp 를 쓴다.
CLINICALNLP_RUNTIME_ROOT=

# nginx/tls-available/ 의 HTTPS server 블록을 로드할 디렉터리.
# 기본값 ./nginx/tls-enabled 는 비어 있다.
NGINX_TLS_DIR=
# 호스트 certbot 이 인증서를 두는 경로. nginx 가 읽기전용으로 마운트한다.
LETSENCRYPT_DIR=
# HTTP-01 챌린지 webroot. certbot 이 쓰고 nginx 가 읽는다.
CERTBOT_WEBROOT=

# ---------------------------------------------------------------------
# AI 서비스
# ---------------------------------------------------------------------
# 악화 예측 모델 마이크로서비스 (services/riskmodel · profile: risk)
PREDICT_AI_URL=http://riskmodel:8790
PREDICT_AI_TIMEOUT_SECONDS=60
# 재예측 스케줄러. 데모 시계 진행에 맞춰 예측을 갱신한다.
# 대상은 app.cohort 이며, 같은 예측 시점을 다시 계산해도 행이 늘지 않는다.
PREDICT_SCHEDULER_ENABLED=true
# 폴링 주기(초). 실제 실행은 15분 슬롯(00/15/30/45)이 바뀐 주기에만 일어난다.
# 이 값은 "슬롯 경계에서 얼마나 늦게 도는가"의 상한이다.
PREDICT_SCHEDULER_INTERVAL_SECONDS=60
# 한 슬롯의 환자를 riskmodel 로 보낼 때 동시 요청 수.
# riskmodel 은 uvicorn 워커 1개라 크게 올리면 타임아웃이 난다.
PREDICT_BATCH_CONCURRENCY=4
RECORD_AI_URL=
CLINICAL_RECORD_AI_TIMEOUT_SECONDS=620

# KCD 검색 약어 확장에 사용할 ClinicalNLP 사전 경로(로컬 백엔드 실행 시 설정).
# Docker Compose에서는 /runtime 아래 읽기 전용 사전을 자동으로 사용한다.
KCD_ALIAS_DB_PATH=
STT_TIMEOUT_SECONDS=300
STT_POLL_INTERVAL_SECONDS=0.5
STT_CLOUD_WORKERS=3
STT_MAX_UPLOAD_MB=25
STT_MAX_AUDIO_DURATION_SECONDS=7200

QDRANT_URL=

# ---------------------------------------------------------------------
# 위험구간 경계 (악화 예측 모델 C · v2.0.0)
# ---------------------------------------------------------------------
# 🚨 artifacts/bundle.json["risk_bands"] 의 실측 경계다. 임의로 바꾸지 말 것.
#    저장소 옛 기본값(0.30/0.60/0.80)을 쓰면 거의 전원이 stable 로 표시된다.
#    모델은 3단계(🟢저위험/🟡악화/🔴매우악화), 화면은 4단계라
#    🔴 을 rising/critical 로 한 번 더 나눈다.
RISK_WATCH=0.035838
RISK_RISING=0.133371
RISK_CRITICAL=0.40

# ---------------------------------------------------------------------
# 데이터 적재 스크립트
# ---------------------------------------------------------------------
# MIMIC-IV-ED / MIMIC-IV-HOSP / MIMIC-IV-ICU 상위 디렉터리. 기본값은 저장소 루트.
MIMIC_DATA_DIR=
# 코호트 선별 시드. 바꾸면 다른 코호트가 뽑힌다.
COHORT_SEED=20260826
